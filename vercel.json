{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "python",
  "regions": ["iad1"],
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "cd web_mantenimiento_uci && python manage.py migrate --noinput && python manage.py collectstatic --noinput",
  "env": {
    "DJANGO_SETTINGS_MODULE": "web_mantenimiento_uci.settings"
  },
  "staticFiles": [
    {
      "src": "/static/**/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
